<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for Android 12+ cloud backup and device transfer.
   Keep authentication/session material out of backups.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="RNCAsyncStorage.xml"/>
        <exclude domain="sharedpref" path="RKStorage.xml"/>
        <exclude domain="database" path="RKStorage"/>
        <exclude domain="database" path="RKStorage-wal"/>
        <exclude domain="database" path="RKStorage-shm"/>
        <exclude domain="file" path="mmkv"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="RNCAsyncStorage.xml"/>
        <exclude domain="sharedpref" path="RKStorage.xml"/>
        <exclude domain="database" path="RKStorage"/>
        <exclude domain="database" path="RKStorage-wal"/>
        <exclude domain="database" path="RKStorage-shm"/>
        <exclude domain="file" path="mmkv"/>
    </device-transfer>
    -->
</data-extraction-rules>
